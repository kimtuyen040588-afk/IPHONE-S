# Public URL exposed through Nginx. The Mac gateway uses this address.
PUBLIC_ORIGIN=https://hgykny55888.it.com
PORT=4310
DATABASE_URL=postgresql://phone_farm_relay:CHANGE_ME@postgres:5432/phone_farm_relay

# Generate both with: openssl rand -hex 32
# Console token protects task creation and gateway enrollment. It is not a
# user account; keep it off public web pages and out of source control.
RELAY_CONSOLE_TOKEN=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
